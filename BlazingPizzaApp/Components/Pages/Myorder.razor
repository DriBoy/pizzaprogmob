@page "/myorders"
@using BlazingPizzaApp.Data
@using BlazingPizzaApp.Model
<div class="myorders-page">
    <h1>My Orders</h1>
    @if (orders == null)
    {
        <p>Loading...</p>
    }
    else if (orders.Count == 0)
    {
        <p class="empty-cart" style="margin-top: 3rem; color: #999;">You haven't ordered any pizza yet.</p>
    }
    else
    {
        <div class="order-summary-grid">
            @foreach (var order in orders)
            {
                <div class="order-summary-card">
                    <button type="button" title="Cancel Order" class="cancel-order-btn"
                            @onclick="@(() => RemoveOrder(order.OrderId))">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                            <path d="M10 11v6"></path>
                            <path d="M14 11v6"></path>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                        </svg>
                    </button>
                    <div class="order-summary-header">
                        <span class="order-id">Order #@order.OrderId</span>
                        <span class="order-date">@order.CreatedTime.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <ul class="order-summary-items">
                        @foreach (var pizza in order.Pizzas)
                        {
                            <li>
                                <span>@(pizza.Size)" @pizza.Special?.Name</span>
                                <span class="item-price">@pizza.GetFormattedTotalPrice()</span>
                            </li>
                        }
                    </ul>
                    <div class="order-summary-footer">
                        <span>Total</span>
                        <span class="order-total-price">£@order.GetFormattedTotalPrice()</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] private IOrderRepository OrderRepositoryService { get; set; } = default!;
    private List<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderRepositoryService.GetOrdersAsync();
    }

    async Task RemoveOrder(int orderId)
    {
        await OrderRepositoryService.RemoveOrderAsync(orderId);
        orders = await OrderRepositoryService.GetOrdersAsync();
    }
}